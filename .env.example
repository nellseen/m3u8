# ==============================================================================
# Telegram Userbot Configuration
# ==============================================================================
# 💡 SATU-SATUNYA YANG WAJIB DIISI ADALAH TELEGRAM_API_ID & TELEGRAM_API_HASH!
#
# Dapatkan dari: https://my.telegram.org -> API development tools
# (Atau cukup jalankan `pnpm run login` dan Anda akan dituntun secara otomatis!)
# ==============================================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ==============================================================================
# ⚙️ PENGATURAN OTOMATIS (TIDAK PERLU DIISI / DIUBAH SECARA MANUAL)
# Semua nilai di bawah ini sudah memiliki default otomatis bawaan sistem.
# ==============================================================================

# Session string akun Telegram (otomatis diisi saat Anda menjalankan `pnpm run login`)
TELEGRAM_SESSION=
SESSION_FILE_PATH="./session.txt"

# Pengaturan antrian & batas waktu unduhan (Default otomatis)
MAX_CONCURRENT_JOBS=2
DOWNLOAD_TIMEOUT_SECONDS=900

# Folder kerja aplikasi (Otomatis dibuat oleh sistem)
TEMP_DIR="./temp"
OUTPUT_DIR="./output"
LOG_DIR="./logs"

# Port server untuk health-check / monitoring
PORT=3000

# Perilaku auto-download URL (Default: Aktif di Saved Messages & Chat Pribadi)
AUTO_DOWNLOAD_SAVED_MESSAGES=true
AUTO_DOWNLOAD_PRIVATE=true
AUTO_DOWNLOAD_GROUPS=false
COMMAND_PREFIX="."

# Jalur binary (Otomatis dideteksi sistem: ffmpeg, yt-dlp, streamlink, chromium)
# FFMPEG_PATH=""
# YTDLP_PATH=""
# STREAMLINK_PATH=""
# CHROMIUM_PATH=""
